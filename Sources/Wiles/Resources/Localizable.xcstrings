    "helpTagsDesc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable 'Show Tags' in View/Options menu. Right-click any file > Tags to color tag it. Click sidebar color tags or search 'tag:color' to filter."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative 'Mostrar Etiquetas' no menu Visualizar ou Opções. Clique com o botão direito no arquivo > Etiquetas. Clique na barra lateral ou busque 'tag:cor' para filtrar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active 'Mostrar Etiquetas' en el menú Vista u Opciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez 'Afficher les étiquettes' dans le menu Présentation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie 'Tags anzeigen' im Menü Ansicht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
