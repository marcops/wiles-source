    "fullDiskAccessNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Full Disk Access in System Settings to access all folders without repeated permission prompts."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda Acesso Total ao Disco nos Ajustes do Sistema para acessar todas as pastas sem novos pedidos de permissão."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda acceso total al disco en Configuración del Sistema para acceder a todas las carpetas sin avisos repetidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accordez un accès complet au disque dans Réglages Système pour accéder à tous les dossiers sans demandes répétées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewähren Sie Vollzugriff auf die Festplatte in den Systemeinstellungen, um ohne wiederholte Abfragen auf alle Ordner zuzugreifen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedi l'accesso completo al disco in Impostazioni di Sistema per accedere a tutte le cartelle senza ulteriori richieste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定でフルディスクアクセスを許可すると、確認なしですべてのフォルダにアクセスできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복적인 권한 요청 없이 모든 폴더에 접근하려면 시스템 설정에서 전체 디스크 접근 권한을 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verleen volledige schijftoegang in Systeeminstellingen om toegang te krijgen tot alle mappen zonder herhaalde meldingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyznaj pełny dostęp do dysku w Ustawieniach systemowych, aby korzystać ze wszystkich folderów bez powtarzających się monitów."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предоставьте полный доступ к диску в Системных настройках, чтобы иметь доступ ко всем папкам без повторных запросов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevilja full skivtillgång i Systeminställningar för att komma åt alla mappar utan upprepade förfrågningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürekli izin istemeden tüm klasörlere erişmek için Sistem Ayarları'ndan Tam Disk Erişimi verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置中授予完全磁盘访问权限，即可访问所有文件夹，无需重复提示。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امنح وصولاً كاملاً للقرص في إعدادات النظام للوصول إلى جميع المجلدات دون المطالبة بإذونات متكررة."
          }
        }
      }
    },
