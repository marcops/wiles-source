            "value": "Right-click any folder or empty background area -> 'Open in Terminal' to launch native Terminal directly at that directory."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito em qualquer pasta ou área vazia -> 'Abrir no Terminal' para abrir o Terminal nativo na pasta atual."
