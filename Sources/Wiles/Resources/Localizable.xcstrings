    "gnomeModeDesc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Enter: Open folder or file\n• F2: Rename item\n• Backspace: Go up to parent folder\n• Ctrl+H: Toggle hidden files"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "• Enter: Abrir pasta ou arquivo\n• F2: Renomear item\n• Backspace: Voltar para pasta pai\n• Ctrl+H: Alternar arquivos ocultos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• Enter: Abrir carpeta\n• F2: Renombrar\n• Backspace: Carpeta superior\n• Ctrl+H: Archivos ocultos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Entrée: Ouvrir le dossier\n• F2: Renommer\n• Retour arrière: Dossier parent\n• Ctrl+H: Fichiers masqués"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• Eingabe: Ordner öffnen\n• F2: Umbenennen\n• Rückschritt: Übergeordneter Ordner\n• Strg+H: Ausgeblendete Dateien"
          }
        },
        "it": {
          "stringUnit": {
